# LINUX-14: Test Dockerfile for Maria HDL Simulator
FROM rust:1.78-slim

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install nextest
RUN curl -LsSf https://get.nexte.st/latest/linux | tar zxf - -C /usr/local/bin

WORKDIR /app
COPY . .

# Cache dependencies
RUN cargo fetch

# Pre-build to cache compilation
RUN cargo build --workspace || true

CMD ["cargo", "nextest", "run", "--workspace"]
