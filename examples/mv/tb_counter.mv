// ─────────────────────────────────────────────────────────────
// Contoh F6 — testbench (MARIA-HDL.md §7)
//   * instansiasi DUT + signal internal (clk/rst_n/enable/count)
//   * initial / forever / repeat / @(posedge clk) / #delay
//   * assert immediate + assert property (emisi 1:1)
//   * $-task: $display, $info, $fatal, $finish
// Generate: maria mgen tb_counter.mv
// Simulasi: maria tb_counter.sv --top tb_counter -T 2000
// ─────────────────────────────────────────────────────────────

module counter_dut #(WIDTH = 8) {
    in  clk, rst_n : bit
    in  enable     : bit
    out count      : logic[WIDTH-1:0]

    seq(clk, rst_n) {
        if (!rst_n) {
            count <= '0
        } else if (enable) {
            count <= count + 1
        }
    }
}

module tb_counter {
    sig clk, rst_n : bit
    sig enable     : bit
    sig count      : logic[7:0]

    inst counter_dut u_counter (.clk, .rst_n, .enable, .count)

    initial {
        $display("tb_counter: mulai")
        clk   = 0
        rst_n = 0
        enable = 0
        #20
        rst_n  = 1
        enable = 1
        repeat (300) @(posedge clk)
        $finish
    }

    initial {
        forever #5 clk = ~clk
    }

    initial {
        #40
        assert (count > 0) $info("counter ok") else $fatal("counter stuck")
        assert property (@(posedge clk) count === count)

        // Catatan: `assert property` body di-emit 1:1 (raw). Bentuk SVA `|->`
        // (mis. `enable |-> count == $past(count) + 1`) juga didukung — lihat
        // MARIA-HDL.md §7.2 — tapi butuh tool EDA yang mendukung operator
        // implication (Verilator/VCS); parser SV Maria belum lex `|->`.
    }
}
