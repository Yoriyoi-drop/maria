// ─────────────────────────────────────────────────────────────
// Contoh F31 — parameter module & override parameter (MARIA-HDL.md §6)
//   * `module counter_w #(WIDTH = 4, STEP = 1)` — parameter ber-default.
//   * `inst counter_w u_big #(.WIDTH(8), .STEP(2)) (...)` — override
//     parameter saat instansiasi (validasi nama parameter di check.rs:
//     parameter tak dikenal → E2001, override dua kali → E2007).
// Generate: maria mgen param_counter.mv
// Simulasi: maria param_counter.sv --top tb_param -T 200
// ─────────────────────────────────────────────────────────────

module counter_w #(WIDTH = 4, STEP = 1) {
    in  clk, rst_n : bit
    out count      : logic[WIDTH-1:0]

    seq(clk, rst_n) {
        if (!rst_n) {
            count <= '0
        } else {
            count <= count + STEP
        }
    }
}

module tb_param {
    sig clk, rst_n : bit
    sig cnt4 : logic[3:0]
    sig cnt8 : logic[7:0]

    // WIDTH=4 (default), STEP=1 (default)
    inst counter_w u_small (.clk, .rst_n, .count(cnt4))
    // override: WIDTH=8, STEP=2
    inst counter_w u_big #(.WIDTH(8), .STEP(2)) (.clk, .rst_n, .count(cnt8))

    initial {
        clk   = 0
        rst_n = 0
        #10
        rst_n = 1
        // body repeat eksplisit `{}` agar `if` TIDAK tertelan (lihat F31 note).
        repeat (10) @(posedge clk) {}
        #1
        // #1: beri waktu NBA `count <= count+STEP` settle (SV race klasik —
        // display di time-step posedge ke-10 melihat nilai SEBELUM update).
        // u_big: 10 posedge × STEP 2 = 20; u_small: 10 (4-bit, 1010 = 10)
        if (cnt8 == 8'd20 && cnt4 == 4'd10) {
            $display("TB_PARAM_OK cnt8=%0d cnt4=%0d", cnt8, cnt4)
        } else {
            $display("TB_PARAM_BROKEN cnt8=%0d cnt4=%0d", cnt8, cnt4)
        }
        $finish
    }

    initial {
        forever #5 clk = ~clk
    }
}
